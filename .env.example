# IMPORTANT: after copying this file to .env, run: chmod 600 .env
# It contains secrets (API keys, app passwords).

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# rss.app feed URLs for LinkedIn job searches (comma-separated)
LINKEDIN_RSS_FEEDS=

# Adzuna API credentials — get them at developer.adzuna.com (free tier: 1,000 calls/month)
# Only needed if the Adzuna scraper is re-enabled in main.py
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Failure email notifications (optional)
# NOTIFY_EMAIL: the Gmail address to send failure alerts to
# GMAIL_APP_PASSWORD: generate at myaccount.google.com → Security → App passwords
NOTIFY_EMAIL=
GMAIL_APP_PASSWORD=
